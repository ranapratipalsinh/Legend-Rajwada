{% comment %}
  A thin, rotating strip of messages above the header — free shipping
  thresholds, a seasonal note, a promo code. Its own section (rather than
  baked into sections/header.liquid) so merchants can remove, reorder, or
  duplicate it independently of the header inside header-group.json.
{% endcomment %}

<div
  class="announcement-bar"
  data-component="{% if section.blocks.size > 1 %}announcement-bar{% endif %}"
  data-interval="{{ section.settings.rotation_speed | times: 1000 }}"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="announcement-bar__track">
    {% for block in section.blocks %}
      <div
        class="announcement-bar__item"
        {% if forloop.index0 != 0 %}hidden{% endif %}
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {% else %}
          <span>{{ block.settings.text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .announcement-bar {
    text-align: center;
    font-size: var(--font-size-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding-block: var(--space-2xs);
  }
  .announcement-bar__track {
    position: relative;
  }
  .announcement-bar__item a {
    text-decoration: none;
  }
  .announcement-bar__item a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.header_background",
      "default": "#211F1C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#E4E2DC"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:labels.rotation_speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:general.announcement_message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "Complimentary shipping on all orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}

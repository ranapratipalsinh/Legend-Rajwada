{% comment %}
  Blog page — a grid of article cards (image, date, title, excerpt).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="page-shell">
  {% render 'breadcrumb' %}

  <header class="page-header">
    <h1 class="page-header__title">{{ blog.title }}</h1>
  </header>

  {% paginate blog.articles by 9 %}
    {% if blog.articles.size > 0 %}
      <ul class="article-grid">
        {% for article in blog.articles %}
          <li>
            <article class="article-card">
              <a href="{{ article.url }}" class="article-card__media ratio-landscape" tabindex="-1" aria-hidden="true">
                {% if article.image %}
                  {% render 'image', image: article.image, class: 'article-card__image', width: 900 %}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'article-card__placeholder' }}
                {% endif %}
              </a>
              <div class="article-card__body">
                <p class="text-eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="article-card__title text-h5">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>
                {% assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 28 %}
                {% if excerpt != blank %}
                  <p class="article-card__excerpt text-body">{{ excerpt }}</p>
                {% endif %}
                <span class="article-card__more text-button-label" aria-hidden="true">{{ 'blog.read_more' | t }}</span>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {% else %}
      <p class="text-body-lg">{{ 'blog.empty' | t }}</p>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .article-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl) var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 750px) {
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 990px) {
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .article-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .article-card__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }
  .article-card__media .image {
    height: 100%;
  }
  .article-card__placeholder {
    width: 100%;
    height: 100%;
    fill: var(--color-line);
  }
  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .article-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .article-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .article-card__title a:focus-visible {
    outline: none;
  }
  .article-card:has(.article-card__title a:focus-visible) {
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius-md);
  }
  .article-card__excerpt {
    color: var(--color-foreground-soft);
  }
  .article-card__more {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}

{% comment %}
  Landing page shown while the store is password-protected — the shop's
  logo or name, the merchant's password-page message, and the password
  form, centred on the brand's own colours.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password-page">
  <div class="password-page__inner">
    {% if section.settings.logo %}
      {% render 'image', image: section.settings.logo, class: 'password-page__logo', width: 400 %}
    {% else %}
      <p class="password-page__shop text-display">{{ shop.name }}</p>
    {% endif %}

    <h1 class="text-h5">{{ 'password.title' | t }}</h1>

    {% if shop.password_message != blank %}
      <p class="password-page__message text-body">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-page__form' %}
      {% if form.errors %}
        <div class="field__message field__message--error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="field">
        <label class="field__label" for="PasswordInput">{{ 'password.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          {% if form.errors %}
            aria-invalid="true"
          {% endif %}
          required
        >
      </div>

      <button type="submit" class="btn btn--primary">{{ 'password.enter' | t }}</button>
    {% endform %}

    <p class="password-page__owner text-caption">
      {{ 'password.owner' | t }}
      <a href="/admin">{{ 'password.login' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: var(--space-xl) var(--space-md);
  }
  .password-page__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: min(26rem, 100%);
    text-align: center;
  }
  .password-page__logo {
    max-width: 10rem;
  }
  .password-page__shop {
    color: var(--color-accent);
  }
  .password-page__message {
    color: var(--color-foreground-soft);
  }
  .password-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    text-align: start;
  }
  .password-page__form .btn {
    width: 100%;
  }
  .password-page__owner {
    color: var(--color-foreground-soft);
  }
  .password-page__owner a {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo_image"
    }
  ]
}
{% endschema %}

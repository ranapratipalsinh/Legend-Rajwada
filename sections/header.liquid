<!-- Announcement Bar -->
{% if section.settings.announcement_text != blank %}
  <div class="announcement-bar">
    {{ section.settings.announcement_text }}
  </div>
{% endif %}

<header class="premium-header">
  <div class="header__left">
    <button class="header__mobile-toggle" aria-label="Toggle Menu">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
    <div class="header__menu">
      {% if section.settings.menu.links.size > 0 %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="/" class="menu-link">Home</a>
        <a href="/collections/all" class="menu-link">Collections</a>
        <a href="/pages/our-legacy" class="menu-link">Our Legacy</a>
        <a href="/pages/our-clients" class="menu-link">Our Clients</a>
        <a href="/pages/contact" class="menu-link">Contact</a>
      {% endif %}
    </div>
  </div>

  <div class="header__center">
    {%- if section.settings.logo != blank -%}
      <a href="{{ routes.root_url }}" class="header__logo-link" style="--logo-height: {{ section.settings.logo_height }}px;">
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'header__logo-image', loading: 'eager', alt: shop.name }}
      </a>
    {%- else -%}
      <h1 class="header__title">
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
      </h1>
    {%- endif -%}
  </div>

  <div class="header__right">
    <div class="header__icons">
      <!-- Search Icon -->
      <a href="{{ routes.search_url }}" class="icon-link" aria-label="Search">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
        </svg>
      </a>

      <!-- Account Icon -->
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="icon-link" aria-label="Account">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </a>
      {% endif %}

      <!-- Cart Icon -->
      <a href="{{ routes.cart_url }}" class="icon-link cart-link" aria-label="Cart">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="nav-icon">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div id="MobileMenuOverlay" class="mobile-menu-overlay" onclick="window.premiumTheme.closeMobileMenu()"></div>
<div id="MobileMenuDrawer" class="mobile-menu-drawer">
  <div class="mobile-menu-header">
    <h3 class="mobile-menu-title">{{ shop.name }}</h3>
    <button class="mobile-menu-close" onclick="window.premiumTheme.closeMobileMenu()">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.5rem; height: 1.5rem;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="mobile-menu-links">
    {% if section.settings.menu.links.size > 0 %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a href="/" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">Home</a>
      <a href="/collections/all" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">Collections</a>
      <a href="/pages/our-legacy" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">Our Legacy</a>
      <a href="/pages/our-clients" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">Our Clients</a>
      <a href="/pages/contact" class="mobile-menu-link" onclick="window.premiumTheme.closeMobileMenu()">Contact</a>
    {% endif %}
  </div>
  <div class="mobile-menu-footer">
    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" class="mobile-menu-footer-link" onclick="window.premiumTheme.closeMobileMenu()">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:1.2rem;height:1.2rem;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        My Account
      </a>
    {% endif %}
    <a href="{{ routes.search_url }}" class="mobile-menu-footer-link" onclick="window.premiumTheme.closeMobileMenu()">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:1.2rem;height:1.2rem;">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      Search
    </a>
  </div>
</div>

{% stylesheet %}
  .premium-header {
    height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4%;
    background-color: rgba(11, 11, 11, 0.95);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.4s ease;
  }

  .header--scrolled {
    height: 4.5rem;
    background-color: rgba(8, 7, 6, 0.98);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .header__left, .header__right {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .header__right {
    justify-content: flex-end;
  }

  .header__center {
    flex: 2;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .header__title {
    font-family: var(--font-heading) !important;
    font-size: 1.6rem;
    letter-spacing: 4px;
    margin: 0;
    text-transform: uppercase;
    transition: font-size 0.4s ease;
  }

  .header--scrolled .header__title {
    font-size: 1.3rem;
  }

  .header__title a {
    color: var(--color-secondary) !important;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .header__title a:hover {
    color: var(--color-accent-light) !important;
  }

  .header__logo-link {
    display: flex;
    align-items: center;
    transition: var(--transition-smooth);
  }

  .header__logo-image {
    height: var(--logo-height, 40px);
    width: auto;
    object-fit: contain;
    transition: height 0.4s ease;
  }

  .header--scrolled .header__logo-image {
    height: calc(var(--logo-height, 40px) * 0.8);
  }

  .header__menu {
    display: flex;
    flex-wrap: nowrap;
    gap: 2.5rem;
  }

  .menu-link {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    white-space: nowrap;
    transition: var(--transition-smooth);
    position: relative;
    padding-bottom: 2px;
  }

  .menu-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-secondary);
    transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .menu-link:hover {
    color: var(--color-secondary);
  }

  .menu-link:hover::after {
    width: 100%;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .icon-link {
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
    position: relative;
    display: flex;
    align-items: center;
  }

  .icon-link:hover {
    color: var(--color-secondary);
  }

  .nav-icon {
    width: 1.35rem;
    height: 1.35rem;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -10px;
    background-color: var(--color-secondary);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 600;
    border-radius: 50%;
    width: 17px;
    height: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
  }

  .header__mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 5px;
    align-items: center;
    justify-content: center;
    margin-right: 1rem;
    transition: var(--transition-smooth);
  }

  .header__mobile-toggle:hover {
    color: var(--color-secondary);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .premium-header {
      height: 4.5rem;
      padding: 0 5%;
    }

    .header--scrolled {
      height: 4rem;
    }

    .header__mobile-toggle {
      display: flex;
    }

    .header__menu {
      display: none !important;
    }

    .header__title {
      font-size: 1.1rem;
      letter-spacing: 2px;
    }

    .header--scrolled .header__title {
      font-size: 1rem;
    }

    .header__icons {
      gap: 1rem;
    }

    .nav-icon {
      width: 1.2rem;
      height: 1.2rem;
    }
  }

  /* Mobile Drawer Styling */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.8);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
    backdrop-filter: blur(4px);
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-drawer {
    position: fixed;
    top: 0;
    left: -320px;
    width: 100%;
    max-width: 320px;
    height: 100%;
    background-color: var(--color-background-main);
    border-right: 1px solid var(--color-border-subtle);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    box-shadow: 5px 0 40px rgba(0, 0, 0, 0.6);
    transition: left 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-drawer.is-active {
    left: 0;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-menu-title {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    font-size: 1.1rem;
    margin: 0;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .mobile-menu-close {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .mobile-menu-close:hover {
    color: var(--color-secondary);
  }

  .mobile-menu-links {
    flex: 1;
    overflow-y: auto;
    padding: 2.5rem 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-menu-link {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-text-main);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    transition: var(--transition-smooth);
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    padding: 1.2rem 0;
  }

  .mobile-menu-link:hover {
    color: var(--color-secondary);
    padding-left: 8px;
    border-color: var(--color-border-gold);
  }

  .mobile-menu-footer {
    padding: 24px;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-menu-footer-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: var(--transition-smooth);
  }

  .mobile-menu-footer-link:hover {
    color: var(--color-secondary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Replaces the text site name when set. Leave blank to keep using the store name as text."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Complimentary Shipping on Orders Above ₹25,000 — Handcrafted Royal Elegance"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}

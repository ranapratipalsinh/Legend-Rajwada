<footer class="premium-footer">
  <div class="footer__content">
    <div class="footer__column brand-info reveal">
      <h3 class="footer__brand-title">{{ shop.name }}</h3>
      <p class="footer__brand-desc">Where the legacy of royal craftsmanship meets modern sophistication. Each garment tells a story of heritage, handwoven into the fabric of timeless elegance.</p>
      <div class="footer__social">
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" class="footer-social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px;"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" class="footer-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px;"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.social_whatsapp != blank %}
          <a href="{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener" class="footer-social-link" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
    <div class="footer__column reveal reveal-delay-1">
      <h4 class="footer__heading">Navigation</h4>
      <div class="footer__links">
        {% if section.settings.menu.links.size > 0 %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="/" class="footer-link">Home</a>
          <a href="/collections/all" class="footer-link">Collections</a>
          <a href="/pages/our-legacy" class="footer-link">Our Legacy</a>
          <a href="/pages/our-clients" class="footer-link">Our Clients</a>
          <a href="/pages/stores" class="footer-link">Stores</a>
          <a href="/pages/contact" class="footer-link">Contact</a>
        {% endif %}
      </div>
    </div>
    <div class="footer__column reveal reveal-delay-2">
      <h4 class="footer__heading">Customer Care</h4>
      <div class="footer__links">
        <a href="/pages/shipping-amp-delivery" class="footer-link">Shipping & Delivery</a>
        <a href="/pages/returns-refunds" class="footer-link">Returns & Exchange</a>
        <a href="/pages/privacy-policy" class="footer-link">Privacy Policy</a>
        <a href="/pages/terms-conditions" class="footer-link">Terms of Service</a>
      </div>
    </div>
    <div class="footer__column reveal reveal-delay-3">
      <h4 class="footer__heading">Secure Payment</h4>
      <div class="footer__payment">
        {% if section.settings.show_payment_icons %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        {% else %}
          <p class="footer__brand-desc">All major international cards accepted securely.</p>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="footer__bottom">
    <div class="footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved. Crafted with Timeless Luxury.
    </div>
    <div class="footer__design-credit">
      Design by <a href="https://ivisioncraft.dev/" target="_blank" rel="noopener">iVisionCraft</a>
    </div>
  </div>
</footer>

{% stylesheet %}
  .premium-footer {
    background-color: #060505;
    color: var(--color-text-muted);
    padding: 5rem 4% 2rem 4%;
    border-top: 1px solid var(--color-border-subtle);
    margin-top: 0;
    font-family: var(--font-body);
    position: relative;
  }

  .footer__content {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 4rem;
    max-width: 1280px;
    margin: 0 auto 3rem auto;
  }

  .footer__brand-title {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    font-size: 1.3rem;
    margin-bottom: 1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .footer__brand-desc {
    font-size: 0.85rem;
    line-height: 1.7;
    max-width: 360px;
    color: var(--color-text-muted);
  }

  .footer__social {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .footer-social-link {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
  }

  .footer-social-link:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    background: rgba(201, 169, 110, 0.05);
  }

  .footer__heading {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    font-size: 0.85rem;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: var(--transition-smooth);
    letter-spacing: 0.3px;
  }

  .footer-link:hover {
    color: var(--color-secondary);
    padding-left: 5px;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footer__payment svg {
    height: 28px;
    width: auto;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .footer__payment svg:hover {
    opacity: 1;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding-top: 2rem;
    text-align: center;
    max-width: 1280px;
    margin: 0 auto;
  }

  .footer__copyright {
    font-size: 0.75rem;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.3);
  }

  .footer__design-credit {
    font-size: 0.7rem;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.25);
    margin-top: 0.5rem;
  }

  .footer__design-credit a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .footer__design-credit a:hover {
    color: var(--color-secondary);
  }

  /* Mobile Responsive */
  @media (max-width: 991px) {
    .footer__content {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .premium-footer {
      padding: 3.5rem 5% 2rem 5%;
    }

    .footer__content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__brand-title {
      font-size: 1.1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_whatsapp",
      "label": "WhatsApp URL"
    }
  ]
}
{% endschema %}

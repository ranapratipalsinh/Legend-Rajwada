{% comment %}
  The Premium Luxury Footer — the closing chapter, not a link dump. Two
  layout modes (grid / centered), a brand column that carries a short
  story rather than just a logo, and any number of link columns — each
  its own "link-column" block with a merchant-editable heading — that
  collapse into accordions on mobile instead of dumping every link at
  full height. Legal links fall back to Shopify's own shop.policies when
  no dedicated menu is set, so a merchant gets working policy links the
  moment they fill them in under Settings, with zero extra configuration.
{% endcomment %}

{% liquid
  assign animations_enabled = section.settings.enable_animations

  assign has_social = false
  if section.settings.social_instagram != blank
    assign has_social = true
  endif
  if section.settings.social_facebook != blank
    assign has_social = true
  endif
  if section.settings.social_pinterest != blank
    assign has_social = true
  endif
  if section.settings.social_x != blank
    assign has_social = true
  endif

  assign has_contact = false
  if section.settings.contact_name != blank
    assign has_contact = true
  endif
  if section.settings.contact_email != blank
    assign has_contact = true
  endif
  if section.settings.contact_phone != blank
    assign has_contact = true
  endif
  if section.settings.address != blank
    assign has_contact = true
  endif
  if section.settings.hours != blank
    assign has_contact = true
  endif

  assign use_policies_fallback = true
  if section.settings.legal_menu.links.size > 0
    assign use_policies_fallback = false
  endif

  assign current_year = 'now' | date: '%Y'
  assign copyright_text = 'footer.copyright_html' | t: year: current_year, shop: shop.name
%}

<footer
  class="site-footer site-footer--{{ section.settings.layout_style }}"
  data-component="footer"
  data-animations="{{ animations_enabled }}"
  style="
    --footer-spacing: var(--space-section-{{ section.settings.spacing }});
    {%- if section.settings.background_color %}--footer-background: {{ section.settings.background_color }};{% endif %}
    {%- if section.settings.text_color %}--footer-text-color: {{ section.settings.text_color }};{% endif %}
  "
>
  <div class="site-footer__main">
    <div class="site-footer__brand" data-reveal="up">
      <a href="{{ routes.root_url }}" class="site-footer__logo" data-reveal-child>
        {% if section.settings.logo %}
          {% render 'image', image: section.settings.logo, class: 'site-footer__logo-image' %}
        {% else %}
          <span class="site-footer__logo-text text-h5">{{ shop.name }}</span>
        {% endif %}
      </a>

      {% if section.settings.brand_description != blank %}
        <div class="site-footer__description text-body" data-reveal-child>{{ section.settings.brand_description }}</div>
      {% endif %}

      {% if has_social %}
        {% liquid
          assign follow_instagram_label = 'footer.follow_on_html' | t: platform: 'Instagram'
          assign follow_facebook_label = 'footer.follow_on_html' | t: platform: 'Facebook'
          assign follow_pinterest_label = 'footer.follow_on_html' | t: platform: 'Pinterest'
          assign follow_x_label = 'footer.follow_on_html' | t: platform: 'X'
        %}
        <div class="site-footer__social" data-footer-social data-reveal-child>
          {% if section.settings.social_instagram != blank %}
            <a href="{{ section.settings.social_instagram }}" class="site-footer__social-link" target="_blank" rel="noopener">
              {% render 'icon', name: 'instagram' %}
              {% render 'visually-hidden', text: follow_instagram_label %}
            </a>
          {% endif %}
          {% if section.settings.social_facebook != blank %}
            <a href="{{ section.settings.social_facebook }}" class="site-footer__social-link" target="_blank" rel="noopener">
              {% render 'icon', name: 'facebook' %}
              {% render 'visually-hidden', text: follow_facebook_label %}
            </a>
          {% endif %}
          {% if section.settings.social_pinterest != blank %}
            <a href="{{ section.settings.social_pinterest }}" class="site-footer__social-link" target="_blank" rel="noopener">
              {% render 'icon', name: 'pinterest' %}
              {% render 'visually-hidden', text: follow_pinterest_label %}
            </a>
          {% endif %}
          {% if section.settings.social_x != blank %}
            <a href="{{ section.settings.social_x }}" class="site-footer__social-link" target="_blank" rel="noopener">
              {% render 'icon', name: 'x' %}
              {% render 'visually-hidden', text: follow_x_label %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="site-footer__columns">
      {% for block in section.blocks %}
        {% if block.type == 'link-column' %}
          {% if block.settings.menu.links.size > 0 %}
            <nav class="site-footer__column" aria-label="{{ block.settings.heading }}" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="site-footer__column-trigger text-eyebrow"
                aria-expanded="false"
                aria-controls="footer-panel-{{ block.id }}"
                data-accordion-trigger
              >
                {{ block.settings.heading }}
              </button>
              <div class="site-footer__column-panel" id="footer-panel-{{ block.id }}">
                <ul class="site-footer__link-list">
                  {% for link in block.settings.menu.links %}
                    <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            </nav>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    {% if has_contact %}
      <div class="site-footer__column site-footer__contact" data-reveal="up">
        <p class="site-footer__column-title text-eyebrow" data-reveal-child>{{ 'footer.contact_heading' | t }}</p>
        <div class="site-footer__contact-body" data-reveal-child>
          {% if section.settings.contact_name != blank %}
            <p class="site-footer__contact-name text-body-lg">{{ section.settings.contact_name }}</p>
          {% endif %}
          {% if section.settings.address != blank %}
            <div class="site-footer__address">{{ section.settings.address }}</div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div class="site-footer__hours">{{ section.settings.hours }}</div>
          {% endif %}
          {% if section.settings.contact_phone != blank %}
            <div class="site-footer__phone">{{ section.settings.contact_phone }}</div>
          {% endif %}
          {% if section.settings.contact_email != blank %}
            <a href="mailto:{{ section.settings.contact_email }}" class="site-footer__link">{{ section.settings.contact_email }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="site-footer__divider site-footer__divider--{{ section.settings.divider_style }}"></div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright text-caption">
      {{ copyright_text }}
    </p>

    <nav class="site-footer__legal" aria-label="{{ 'footer.legal_heading' | t }}">
      {% if use_policies_fallback %}
        {% for policy in shop.policies %}
          {% if policy.body != blank %}
            <a href="{{ policy.url }}" class="site-footer__legal-link">{{ policy.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for link in section.settings.legal_menu.links %}
          <a href="{{ link.url }}" class="site-footer__legal-link">{{ link.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    {% if section.settings.show_payment_icons %}
      <div class="site-footer__payment">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background-color: var(--footer-background, var(--color-background));
    color: var(--footer-text-color, var(--color-foreground));
    padding: var(--footer-spacing, var(--space-section-md)) var(--page-margin) var(--space-lg);
  }

  /* ---------- Main column area ---------- */
  .site-footer__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 26rem;
  }
  .site-footer__logo {
    display: inline-flex;
    text-decoration: none;
    color: inherit;
  }
  .site-footer__logo-image {
    width: 9rem;
  }
  .site-footer__logo-image.image > img {
    width: 100%;
    height: auto;
  }
  .site-footer__description {
    color: var(--color-foreground-soft);
  }
  .site-footer__social {
    display: flex;
    gap: var(--space-md);
  }
  .site-footer__social-link {
    display: inline-flex;
    color: inherit;
    opacity: 0.75;
    transition: opacity var(--duration-fast) var(--ease-signature), transform var(--duration-fast) var(--ease-signature);
  }
  .site-footer__social-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .site-footer__column-title,
  .site-footer__column-trigger {
    color: var(--color-foreground-soft);
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: default;
  }
  .site-footer__link-list {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .site-footer__link,
  .site-footer__legal-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size var(--duration-base) var(--ease-out-soft);
  }
  .site-footer__link:hover,
  .site-footer__legal-link:hover {
    background-size: 100% 1px;
  }

  .site-footer__columns {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .site-footer__contact-body {
    margin-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .site-footer__contact-name {
    color: var(--color-foreground);
  }
  .site-footer__address,
  .site-footer__hours,
  .site-footer__phone {
    color: var(--color-foreground-soft);
  }
  .site-footer__phone {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  /* ---------- Divider ---------- */
  .site-footer__divider {
    border: none;
    border-top: 1px solid var(--color-line);
    margin-bottom: var(--space-lg);
  }
  .site-footer__divider--none { border-top-color: transparent; }
  .site-footer__divider--dashed { border-top-style: dashed; }

  /* ---------- Bottom bar ---------- */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .site-footer__copyright {
    color: var(--color-foreground-soft);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--font-size-caption);
    color: var(--color-foreground-soft);
  }
  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .site-footer__payment svg {
    height: 1.25rem;
    width: auto;
  }

  /* ---------- Mobile (base) — Navigation/Collections columns collapse
     into accordions; brand and contact stay fully visible, since they're
     short and don't benefit from hiding. ---------- */
  .site-footer__column-trigger {
    display: flex;
    align-items: center;
    width: 100%;
    cursor: pointer;
  }
  .site-footer__column-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--duration-base) var(--ease-out-soft);
  }
  .site-footer__column-panel > .site-footer__link-list {
    overflow: hidden;
    min-height: 0;
  }
  .site-footer__column-panel.is-open {
    grid-template-rows: 1fr;
  }

  /* ---------- Tablet (750px+) — two-column pairing for nav/collections,
     brand and contact each take a full row of their own. ---------- */
  @media (min-width: 750px) {
    .site-footer__column-trigger {
      cursor: default;
      pointer-events: none;
    }
    .site-footer__column-panel {
      display: block;
      grid-template-rows: none;
    }
    .site-footer__column-panel > .site-footer__link-list {
      overflow: visible;
    }

    .site-footer__main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
      row-gap: var(--space-xl);
    }
    .site-footer__brand {
      grid-column: 1 / -1;
      max-width: 34rem;
    }
    .site-footer__columns {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      gap: var(--space-xl);
    }
    .site-footer__contact {
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* ---------- Laptop (990px+) — brand, the link-column group, and
     contact sit side by side; the link-column group auto-fits however
     many "link-column" blocks a merchant has added, so this works
     whether there are one, two, or five columns. ---------- */
  @media (min-width: 990px) {
    .site-footer__main {
      grid-template-columns: 1.6fr 2fr 1.2fr;
      column-gap: var(--space-2xl);
    }
    .site-footer__brand,
    .site-footer__columns,
    .site-footer__contact {
      grid-column: auto;
    }
  }

  /* ---------- Desktop (1200px+) — full designed scale ---------- */
  @media (min-width: 1200px) {
    .site-footer {
      padding-inline: var(--space-3xl);
    }
    .site-footer__main {
      grid-template-columns: 2fr 2.2fr 1.3fr;
    }
  }

  /* ---------- Centered layout style — a quiet, single-column colophon ---------- */
  .site-footer--centered .site-footer__main {
    align-items: center;
    text-align: center;
  }
  .site-footer--centered .site-footer__brand {
    align-items: center;
    max-width: 32rem;
    margin-inline: auto;
  }
  @media (min-width: 750px) {
    .site-footer--centered .site-footer__main {
      display: flex;
      flex-direction: column;
    }
    .site-footer--centered .site-footer__columns {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
    .site-footer--centered .site-footer__column-trigger {
      justify-content: center;
    }
    .site-footer--centered .site-footer__link-list {
      align-items: center;
    }
    .site-footer--centered .site-footer__contact-body {
      align-items: center;
    }
    .site-footer--centered .site-footer__bottom {
      align-items: center;
      justify-content: center;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "t:general.brand_story"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo_image"
    },
    {
      "type": "richtext",
      "id": "brand_description",
      "label": "t:labels.brand_description",
      "default": "<p>Modern Maharaja. Rooted in royal heritage, designed for contemporary wedding couture.</p>"
    },
    {
      "type": "header",
      "content": "t:general.navigation"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:labels.legal_menu",
      "info": "t:info.legal_menu"
    },
    {
      "type": "header",
      "content": "t:general.contact"
    },
    {
      "type": "text",
      "id": "contact_name",
      "label": "t:labels.contact_name"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "t:labels.contact_email"
    },
    {
      "type": "richtext",
      "id": "contact_phone",
      "label": "t:labels.contact_phone",
      "info": "t:info.contact_phone"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "t:labels.address"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "t:labels.hours"
    },
    {
      "type": "header",
      "content": "t:general.social_media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "t:labels.social_instagram",
      "info": "t:info.footer_social"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "t:labels.social_facebook"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "t:labels.social_pinterest"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "t:labels.social_x"
    },
    {
      "type": "header",
      "content": "t:general.appearance"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:labels.layout_style",
      "info": "t:info.footer_layout_style",
      "options": [
        { "value": "grid", "label": "t:options.footer_layout.grid" },
        { "value": "centered", "label": "t:options.footer_layout.centered" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.padding",
      "options": [
        { "value": "sm", "label": "t:options.size.small" },
        { "value": "md", "label": "t:options.size.medium" },
        { "value": "lg", "label": "t:options.size.large" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:labels.divider_style",
      "options": [
        { "value": "none", "label": "t:options.divider_style.none" },
        { "value": "line", "label": "t:options.divider_style.line" },
        { "value": "dashed", "label": "t:options.divider_style.dashed" }
      ],
      "default": "line"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.motion"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "t:labels.enable_animations",
      "info": "t:info.enable_animations",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link-column",
      "name": "t:general.link_column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu"
        }
      ]
    }
  ]
}
{% endschema %}

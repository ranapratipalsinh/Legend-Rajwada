{% comment %}
  Standard store page (About us, policies written as pages, size guide…) —
  breadcrumb, title, and the admin-written content in a comfortable reading
  column.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page-shell">
  <div class="container-article">
    {% render 'breadcrumb' %}

    <header class="page-header">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </header>

    <div class="rte text-body">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}

{% comment %}
  The /collections page — every collection as a portrait card with its
  image, title and product count. A collection with no image (and no
  products to borrow one from) shows a placeholder rather than collapsing.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/list-collections
{% endcomment %}

<div class="page-shell">
  <header class="page-header page-header--center">
    <h1 class="page-header__title">{{ 'collections.title' | t }}</h1>
  </header>

  <ul
    class="collections {{ section.settings.grid_item_width }}"
    style="--grid-gap: {{ section.settings.grid_gap }}px"
  >
    {% for collection in collections %}
      <li>
        <a class="collection-card" href="{{ collection.url }}">
          <div class="collection-card__media ratio-portrait">
            {% if collection.featured_image %}
              {% render 'image',
                class: 'collection-card__image',
                image: collection.featured_image,
                width: 800
              %}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
            {% endif %}
          </div>
          <div class="collection-card__content">
            <span class="text-collection-title">{{ collection.title }}</span>
            <span class="collection-card__count text-caption">
              {{- 'collections.product_count' | t: count: collection.products_count -}}
            </span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--collection-card-size), 100%), 1fr));
    gap: max(var(--grid-gap), var(--space-md));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .collections--compact {
    --collection-card-size: 160px;
  }
  .collections--full {
    --collection-card-size: 280px;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-decoration: none;
    color: inherit;
  }
  .collection-card__media {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }
  .collection-card__media .image {
    height: 100%;
  }
  .collection-card__media img {
    transition: transform var(--duration-slow) var(--ease-out-soft);
  }
  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    fill: var(--color-line);
  }
  @media (hover: hover) {
    .collection-card:hover .collection-card__media img {
      transform: scale(1.03);
    }
  }
  .collection-card:focus-visible {
    outline: none;
  }
  .collection-card:focus-visible .collection-card__media {
    box-shadow: var(--shadow-focus);
  }
  .collection-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .collection-card__count {
    color: var(--color-foreground-soft);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}

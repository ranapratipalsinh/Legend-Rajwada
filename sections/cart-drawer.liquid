<div id="CartDrawerOverlay" class="cart-drawer-overlay" onclick="window.premiumTheme.closeCartDrawer()"></div>
<div id="CartDrawer" class="cart-drawer-sidebar">
  <div class="cart-drawer-header">
    <h3 class="cart-drawer-title">Shopping Bag</h3>
    <button class="cart-drawer-close" onclick="window.premiumTheme.closeCartDrawer()" aria-label="Close cart">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 1.5rem; height: 1.5rem;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="CartDrawerContent" class="cart-drawer-content">
    <!-- Content will be injected dynamically via AJAX in JS -->
    <div class="cart-drawer-empty">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" style="width:3rem;height:3rem;color:var(--color-border-gold);margin-bottom:1.5rem;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>
      <p style="color:var(--color-text-muted);font-size:0.95rem;">Your luxury bag is empty.</p>
    </div>
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-drawer-subtotal">
      <span class="subtotal-label">Subtotal</span>
      <span id="CartDrawerSubtotal" class="subtotal-value">{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer-note">Shipping & taxes calculated at checkout.</p>
    <a href="/checkout" class="btn-premium btn-premium-filled checkout-btn-drawer">Proceed to Checkout</a>
    <a href="{{ routes.cart_url }}" class="cart-drawer-view-cart">View Full Cart</a>
  </div>
</div>

{% stylesheet %}
  /* Cart Drawer Layout */
  .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.75);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease;
    backdrop-filter: blur(4px);
  }

  .cart-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .cart-drawer-sidebar {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background-color: var(--color-background-main);
    border-left: 1px solid var(--color-border-subtle);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    box-shadow: -5px 0 40px rgba(0, 0, 0, 0.5);
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cart-drawer-sidebar.is-active {
    transform: translateX(0);
  }

  .cart-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--color-border-subtle);
    flex-shrink: 0;
  }

  .cart-drawer-title {
    font-family: var(--font-heading);
    color: var(--color-secondary);
    font-size: 1.1rem;
    margin: 0;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .cart-drawer-close {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 5px;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer-close:hover {
    color: var(--color-secondary);
  }

  .cart-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cart-drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem;
    flex: 1;
  }

  .cart-drawer-loading {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 0.95rem;
    text-align: center;
    padding-top: 3rem;
  }

  /* Drawer Items */
  .cart-drawer-item {
    display: flex;
    gap: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 16px 0;
  }

  .cart-drawer-item:first-child {
    padding-top: 0;
  }

  .cart-drawer-item-img {
    width: 75px;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--color-background-card);
    border: 1px solid var(--color-border-subtle);
    flex-shrink: 0;
  }

  .cart-drawer-item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .cart-drawer-item-title {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--color-text-main);
    margin: 0 0 3px 0;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-drawer-item-variant {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0 0 6px 0;
  }

  .cart-drawer-item-price {
    font-size: 0.9rem;
    color: var(--color-secondary);
    font-weight: 500;
    margin: 0;
  }

  .cart-drawer-qty-controls {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 6px;
    border: 1px solid var(--color-border-subtle);
    width: fit-content;
    background: var(--color-background-card);
  }

  .cart-qty-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px 10px;
    font-size: 0.85rem;
    transition: var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-qty-btn:hover {
    color: var(--color-secondary);
  }

  .cart-qty-value {
    font-size: 0.8rem;
    color: var(--color-text-main);
    padding: 4px 8px;
    min-width: 24px;
    text-align: center;
  }

  .cart-drawer-remove {
    background: transparent;
    border: none;
    color: var(--color-danger);
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0;
    text-decoration: none;
    transition: var(--transition-fast);
    font-family: var(--font-body);
  }

  .cart-drawer-remove:hover {
    color: #ff4444;
  }

  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid var(--color-border-subtle);
    background-color: rgba(6, 5, 5, 0.9);
    flex-shrink: 0;
  }

  .cart-drawer-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .subtotal-label {
    font-family: var(--font-heading);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .subtotal-value {
    color: var(--color-secondary);
    font-size: 1.3rem;
    font-weight: 400;
    font-family: var(--font-heading);
  }

  .cart-drawer-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin: 0 0 16px 0;
  }

  .checkout-btn-drawer {
    display: block;
    width: 100%;
    padding: 14px;
    font-size: 0.8rem;
    text-align: center;
    letter-spacing: 3px;
  }

  .cart-drawer-view-cart {
    display: block;
    text-align: center;
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: var(--transition-smooth);
  }

  .cart-drawer-view-cart:hover {
    color: var(--color-secondary);
  }

  /* Mobile Responsive */
  @media (max-width: 480px) {
    .cart-drawer-sidebar {
      max-width: 100%;
    }

    .cart-drawer-header {
      padding: 16px;
    }

    .cart-drawer-content {
      padding: 16px;
    }

    .cart-drawer-footer {
      padding: 16px;
    }

    .cart-drawer-item {
      gap: 10px;
    }

    .cart-drawer-item-img {
      width: 65px;
    }

    .subtotal-value {
      font-size: 1.15rem;
    }
  }
{% endstylesheet %}


{% comment %}
  Contact form — name, email, phone and message, sent to the store's
  sender email address by Shopify's built-in contact form. Used by
  templates/page.contact.json beneath the page's own content; assign that
  template to a page (e.g. "Contact us") in the admin to use it.
{% endcomment %}

<div class="contact-form-section">
  <div class="container-article">
    {% form 'contact', class: 'contact-form' %}
      {% if section.settings.heading != blank %}
        <h2 class="text-h5">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if form.posted_successfully? %}
        <p class="field__message field__message--success" role="status">{{ 'contact.success' | t }}</p>
      {% endif %}
      {% if form.errors %}
        <div class="field__message field__message--error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <div class="contact-form__row">
        <div class="field">
          <label class="field__label" for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
          <input
            class="field__input"
            type="text"
            id="ContactName-{{ section.id }}"
            name="contact[name]"
            value="{{ form.name }}"
            autocomplete="name"
          >
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
          <input
            class="field__input"
            type="email"
            id="ContactEmail-{{ section.id }}"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
            required
          >
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input
          class="field__input"
          type="tel"
          id="ContactPhone-{{ section.id }}"
          name="contact[phone]"
          value="{{ form.phone }}"
          autocomplete="tel"
        >
      </div>

      <div class="field">
        <label class="field__label" for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea
          class="field__textarea"
          id="ContactBody-{{ section.id }}"
          name="contact[body]"
          required
        >
          {{- form.body -}}
        </textarea>
      </div>

      <div>
        <button type="submit" class="btn btn--primary">{{ 'contact.submit' | t }}</button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .contact-form-section {
    padding-bottom: var(--space-section-sm);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .contact-form__row {
    display: grid;
    gap: var(--space-md);
  }
  @media (min-width: 750px) {
    .contact-form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Send us a message"
    }
  ],
  "presets": [{ "name": "t:general.contact_form" }]
}
{% endschema %}

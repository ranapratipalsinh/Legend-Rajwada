{% comment %}
  Full-width autoplaying image slideshow. Each block is one slide with
  its own optional heading/subheading/button. No blocks yet is shown as
  a placeholder so an empty section doesn't render as a blank void.
{% endcomment %}

<div class="slideshow" data-slideshow>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="slideshow__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="slideshow__image" style="background-image: url('{{ block.settings.image | image_url: width: 2000 }}');"></div>
        {%- else -%}
          <div class="slideshow__image slideshow__image--placeholder"></div>
        {%- endif -%}
        <div class="slideshow__overlay"></div>
        {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
          <div class="slideshow__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="slideshow__heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="slideshow__subheading">{{ block.settings.subheading }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="btn-premium">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <button class="slideshow__arrow slideshow__arrow--prev" data-slideshow-prev aria-label="Previous slide">&#10094;</button>
      <button class="slideshow__arrow slideshow__arrow--next" data-slideshow-next aria-label="Next slide">&#10095;</button>
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button class="slideshow__dot {% if forloop.first %}is-active{% endif %}" data-slideshow-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="slideshow__empty">
      <p>Add slides using the "Add block" button in the theme editor.</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .slideshow {
    position: relative;
    width: 100%;
    height: clamp(420px, 60vw, 680px);
    overflow: hidden;
    background-color: var(--color-background-main);
  }

  .slideshow__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease;
    z-index: 0;
  }

  .slideshow__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .slideshow__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .slideshow__image--placeholder {
    background-color: var(--color-background-card);
  }

  .slideshow__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(8, 7, 6, 0.25) 0%, rgba(8, 7, 6, 0.65) 100%);
  }

  .slideshow__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }

  .slideshow__heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-text-main);
    text-shadow: 0 2px 20px rgba(0,0,0,0.4);
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  .slideshow__subheading {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  .slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: transparent;
    border: 1px solid var(--color-border-gold);
    color: var(--color-secondary);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .slideshow__arrow:hover {
    background: var(--color-secondary);
    color: var(--color-primary);
  }

  .slideshow__arrow--prev {
    left: 2rem;
  }

  .slideshow__arrow--next {
    right: 2rem;
  }

  .slideshow__dots {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 0.6rem;
  }

  .slideshow__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--color-secondary);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .slideshow__dot.is-active {
    background: var(--color-secondary);
  }

  .slideshow__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .slideshow__arrow {
      width: 36px;
      height: 36px;
    }

    .slideshow__arrow--prev {
      left: 0.75rem;
    }

    .slideshow__arrow--next {
      right: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
